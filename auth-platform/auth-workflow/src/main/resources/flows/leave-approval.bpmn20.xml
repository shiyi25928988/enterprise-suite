<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="io.github.shiyi.auth.workflow">

    <process id="leave-approval" name="请假审批" isExecutable="true">

        <startEvent id="start" name="提交申请" flowable:initiator="initiator"/>

        <sequenceFlow id="flow1" sourceRef="start" targetRef="aiReview"/>

        <!-- W1-4: AI participant — writes aiSuggestion / aiReason -->
        <serviceTask id="aiReview" name="AI 预审"
                     flowable:delegateExpression="${aiReviewDelegate}"/>

        <sequenceFlow id="flow2" sourceRef="aiReview" targetRef="managerApproval"/>

        <userTask id="managerApproval" name="主管审批"
                  flowable:candidateGroups="ADMIN"
                  flowable:dueDate="${slaClock.hours(48)}"/>

        <sequenceFlow id="flow3" sourceRef="managerApproval" targetRef="decision"/>

        <exclusiveGateway id="decision" name="审批结果"/>

        <sequenceFlow id="flowApprove" sourceRef="decision" targetRef="endApproved">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${approved == true}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flowReject" sourceRef="decision" targetRef="endRejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${approved == false}]]>
            </conditionExpression>
        </sequenceFlow>

        <endEvent id="endApproved" name="已通过"/>
        <endEvent id="endRejected" name="已驳回"/>
    </process>

    <!-- Layout: without this section the engine still runs the process, but the
         admin designer cannot draw it ("no diagram to display"). Kept in sync
         with the semantic part above: every flow node needs a BPMNShape and
         every sequence flow two waypoints. -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_leave_approval">
        <bpmndi:BPMNPlane id="BPMNPlane_leave_approval" bpmnElement="leave-approval">
            <bpmndi:BPMNShape id="start_di" bpmnElement="start">
                <dc:Bounds x="152" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="aiReview_di" bpmnElement="aiReview">
                <dc:Bounds x="240" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="managerApproval_di" bpmnElement="managerApproval">
                <dc:Bounds x="390" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="decision_di" bpmnElement="decision" isMarkerVisible="true">
                <dc:Bounds x="540" y="95" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
                <dc:Bounds x="640" y="62" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
                <dc:Bounds x="640" y="152" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
                <di:waypoint x="188" y="120"/>
                <di:waypoint x="240" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
                <di:waypoint x="340" y="120"/>
                <di:waypoint x="390" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
                <di:waypoint x="490" y="120"/>
                <di:waypoint x="540" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowApprove_di" bpmnElement="flowApprove">
                <di:waypoint x="590" y="120"/>
                <di:waypoint x="640" y="80"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowReject_di" bpmnElement="flowReject">
                <di:waypoint x="590" y="120"/>
                <di:waypoint x="640" y="170"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
