<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:flowable="http://flowable.org/bpmn"
             targetNamespace="io.github.shiyi.auth.workflow">

    <!-- W2 countersign demo: parallel multi-instance approval.
         - approvers: process variable, List of platform usernames (converted
           from the comma-separated form field at start)
         - one veto ends the block early (csRejected, set by the vote ledger
           bookkeeping in WorkflowService)
         - after the block, approved carries the majority decision (ties → pass)
         - SLA: every task is due 48h after creation (slaClock bean) -->
    <process id="purchase-approval" name="采购会签审批" isExecutable="true">

        <startEvent id="start" name="提交申请" flowable:initiator="initiator"/>

        <sequenceFlow id="flow1" sourceRef="start" targetRef="aiReview"/>

        <serviceTask id="aiReview" name="AI 预审"
                     flowable:delegateExpression="${aiReviewDelegate}"/>

        <sequenceFlow id="flow2" sourceRef="aiReview" targetRef="countersign"/>

        <userTask id="countersign" name="会签审批"
                  flowable:assignee="${user}"
                  flowable:dueDate="${slaClock.hours(48)}">
            <multiInstanceLoopCharacteristics isSequential="false"
                    flowable:collection="${approvers}"
                    flowable:elementVariable="user">
                <completionCondition>
                    ${nrOfCompletedInstances >= nrOfInstances || csRejected == true}
                </completionCondition>
            </multiInstanceLoopCharacteristics>
        </userTask>

        <sequenceFlow id="flow3" sourceRef="countersign" targetRef="decision"/>

        <exclusiveGateway id="decision" name="会签结果"/>

        <sequenceFlow id="flowApprove" sourceRef="decision" targetRef="endApproved">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${csRejected != true && approved != false}]]>
            </conditionExpression>
        </sequenceFlow>

        <sequenceFlow id="flowReject" sourceRef="decision" targetRef="endRejected">
            <conditionExpression xsi:type="tFormalExpression">
                <![CDATA[${csRejected == true || approved == false}]]>
            </conditionExpression>
        </sequenceFlow>

        <endEvent id="endApproved" name="已通过"/>
        <endEvent id="endRejected" name="已驳回"/>
    </process>

    <!-- Layout section: same reasoning as leave-approval — the designer needs
         shapes and waypoints, the engine does not. The countersign task is
         drawn wider because bpmn-js adds the multi-instance marker. -->
    <bpmndi:BPMNDiagram id="BPMNDiagram_purchase_approval">
        <bpmndi:BPMNPlane id="BPMNPlane_purchase_approval" bpmnElement="purchase-approval">
            <bpmndi:BPMNShape id="start_di" bpmnElement="start">
                <dc:Bounds x="152" y="102" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="aiReview_di" bpmnElement="aiReview">
                <dc:Bounds x="240" y="80" width="100" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="countersign_di" bpmnElement="countersign">
                <dc:Bounds x="400" y="80" width="120" height="80"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="decision_di" bpmnElement="decision">
                <dc:Bounds x="580" y="95" width="50" height="50"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endApproved_di" bpmnElement="endApproved">
                <dc:Bounds x="690" y="62" width="36" height="36"/>
            </bpmndi:BPMNShape>
            <bpmndi:BPMNShape id="endRejected_di" bpmnElement="endRejected">
                <dc:Bounds x="690" y="152" width="36" height="36"/>
            </bpmndi:BPMNShape>

            <bpmndi:BPMNEdge id="flow1_di" bpmnElement="flow1">
                <di:waypoint x="188" y="120"/>
                <di:waypoint x="240" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow2_di" bpmnElement="flow2">
                <di:waypoint x="340" y="120"/>
                <di:waypoint x="400" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flow3_di" bpmnElement="flow3">
                <di:waypoint x="520" y="120"/>
                <di:waypoint x="580" y="120"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowApprove_di" bpmnElement="flowApprove">
                <di:waypoint x="630" y="120"/>
                <di:waypoint x="690" y="80"/>
            </bpmndi:BPMNEdge>
            <bpmndi:BPMNEdge id="flowReject_di" bpmnElement="flowReject">
                <di:waypoint x="630" y="120"/>
                <di:waypoint x="690" y="170"/>
            </bpmndi:BPMNEdge>
        </bpmndi:BPMNPlane>
    </bpmndi:BPMNDiagram>
</definitions>
