<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.shiyi</groupId>
        <artifactId>auth-platform</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>auth-user</artifactId>
    <name>auth-user</name>
    <description>User domain: user / organization / role management (no awareness of SAS)</description>

    <dependencies>
        <dependency>
            <groupId>io.github.shiyi</groupId>
            <artifactId>auth-common</artifactId>
        </dependency>

        <!-- 库模块：依赖由最终打包方(auth-server)在运行时提供，这里仅为编译期 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- 密码编码（PasswordEncoder）与方法级鉴权注解（@PreAuthorize）。
             只引 core，不引 security starter：本模块不承载过滤器链。 -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
        </dependency>

        <!-- Bean Validation：请求体约束（@NotBlank / @Size / @Pattern） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- MyBatis-Plus（Boot 4 适配版，版本由 auth-platform dependencyManagement 管理） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>

        <!-- 分页插件：3.5.9 起 PaginationInnerInterceptor 从 extension 拆出到此模块，
             不引它 selectPage() 无法编译（运行时也不会真正分页） -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
    </dependencies>

</project>
