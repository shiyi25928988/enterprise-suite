<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!-- 组件 POM：认证平台（SAS 7 + 用户服务），依赖版本管理集中在此 -->
    <parent>
        <groupId>io.github.shiyi</groupId>
        <artifactId>enterprise-suite</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>auth-platform</artifactId>
    <packaging>pom</packaging>
    <name>auth-platform</name>
    <description>Unified authentication platform: Spring Authorization Server 7 + user service</description>

    <modules>
        <module>auth-common</module>
        <module>auth-user</module>
        <module>auth-workflow-api</module>
        <module>auth-workflow</module>
        <module>auth-server</module>
    </modules>

    <properties>
        <!-- 第三方版本：只放 Boot BOM 不管理的库（版本以当时最新稳定版为准） -->
        <mybatis-plus.version>3.5.18</mybatis-plus.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc.version>3.2.0</springdoc.version>
        <poi.version>5.3.0</poi.version>
        <!-- Flowable 8: Spring Framework 7 / Boot 4 / Jackson 3 baseline — matches this project -->
        <flowable.version>8.0.0</flowable.version>

        <!-- 内部模块版本统一引用 -->
        <auth-common.version>${project.version}</auth-common.version>
        <auth-user.version>${project.version}</auth-user.version>
        <auth-workflow-api.version>${project.version}</auth-workflow-api.version>
    </properties>

    <!-- ============ 依赖版本管理（只锁版本，不引入） ============ -->
    <dependencyManagement>
        <dependencies>

            <!-- 内部模块 -->
            <dependency>
                <groupId>io.github.shiyi</groupId>
                <artifactId>auth-common</artifactId>
                <version>${auth-common.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.shiyi</groupId>
                <artifactId>auth-user</artifactId>
                <version>${auth-user.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.shiyi</groupId>
                <artifactId>auth-workflow-api</artifactId>
                <version>${auth-workflow-api.version}</version>
            </dependency>

            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring</artifactId>
                <version>${flowable.version}</version>
            </dependency>

            <!-- MyBatis-Plus（BOM 方式；Boot 4 官方 starter 已发布，已验证存在） -->
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- OpenAPI 文档 -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- 用户批量导入/导出（xlsx） -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <!-- ============ 全模块共享（仅无副作用依赖） ============ -->
    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- ============ 插件管理 ============ -->
    <build>
        <pluginManagement>
            <plugins>

                <!-- 编译：Lombok 必须在 MapStruct 之前 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Amapstruct.defaultComponentModel=spring</arg>
                            <arg>-Amapstruct.unmappedTargetPolicy=IGNORE</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>

                <!-- 测试：Mockito 的 inline mock maker 需要动态挂载 agent，
                     JDK 21 起默认告警，这里显式允许以免污染测试输出 -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading -Xshare:off</argLine>
                    </configuration>
                </plugin>

                <!-- 可执行 jar：仅 auth-server 中启用 -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <configuration>
                        <mainClass>io.github.shiyi.auth.server.AuthServerApplication</mainClass>
                        <layers>
                            <enabled>true</enabled>
                        </layers>
                        <excludes>
                            <exclude>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </exclude>
                        </excludes>
                    </configuration>
                </plugin>

            </plugins>
        </pluginManagement>
    </build>

</project>
